{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$code.length == 5",

        "meta": {
          "code": { ".validate": "newData.isString() && newData.val() == $code" },
          "hostId": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "options": {
          "mode": { ".validate": "newData.val() == 'DUEL' || newData.val() == 'COURSE'" },
          "countdown": { ".validate": "newData.isBoolean()" },
          "sound": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },

        "round": {
          "index": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "state": {
            ".validate": "newData.val() == 'IDLE' || newData.val() == 'COUNTDOWN' || newData.val() == 'ARMED' || newData.val() == 'LOCKED'"
          },
          "armedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "players": {
          "$playerId": {
            ".validate": "$playerId.length <= 32",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 18" },
            "status": { ".validate": "newData.val() == 'ACTIVE' || newData.val() == 'ELIMINATED'" },
            "score": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "buzzes": {
          "$playerId": {
            ".validate": "newData.hasChildren(['round', 'at']) && root.child('rooms').child($code).child('players').child($playerId).exists()",
            "round": { ".validate": "newData.isNumber()" },
            "at": { ".validate": "newData.isNumber()" },
            "precision": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
